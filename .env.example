# ============================================================
# MedFusion AI — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit the real .env file to version control.
# ============================================================

# ---------- Application ----------
APP_NAME=MedFusion AI
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ---------- Backend Server ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ---------- Database ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=medfusion_db
POSTGRES_USER=medfusion_user
POSTGRES_PASSWORD=CHANGE_ME_in_production
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---------- JWT / Auth ----------
SECRET_KEY=CHANGE_ME_generate_a_random_64_char_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- Security ----------
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
RATE_LIMIT_PER_MINUTE=100
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- File Storage ----------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,application/dicom

# ---------- ML Models ----------
MODEL_DIR=./models/registry
DEFAULT_IMAGE_MODEL=densenet121_v1
DEFAULT_TABULAR_MODEL=xgboost_heart_v1
DEFAULT_FUSION_MODEL=late_fusion_v1
INFERENCE_DEVICE=cpu

# ---------- MLflow ----------
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=medfusion-ai

# ---------- Redis (optional) ----------
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0

# ---------- Logging ----------
LOG_LEVEL=INFO
LOG_FORMAT=json
